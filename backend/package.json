{
  "name": "booking-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Group Travel Matcher API (Node.js + Express + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --import tsx src/server.js",
    "dev": "node --import tsx --watch src/server.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run migrate",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback --all",
    "migrate:status": "knex migrate:status",
    "setup": "npm run db:up && npm run migrate",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --import ./tests/setup/env.js --test \"tests/unit/**/*.test.js\"",
    "pretest:integration": "node tests/setup/prepare-test-db.js",
    "test:integration": "node --import tsx --import ./tests/setup/env.js --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:watch": "node --import tsx --import ./tests/setup/env.js --test --watch \"tests/unit/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "seed:travellers": "node scripts/seed-travellers.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2"
  }
}
