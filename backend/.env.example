PORT=4000

# Keep this project's Docker resources separate from other backend folders.
COMPOSE_PROJECT_NAME=booking

DB_HOST=localhost
DB_PORT=5432
DB_USER=booking
DB_PASSWORD=booking
DB_NAME=booking

# Folder holding the hackathon data pack (data/ and images/).
# Relative paths resolve from the backend folder.
DATA_DIR=../hackathon-problem-3-group-travel-matcher

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Tests use a separate database (default: <DB_NAME>_test)
DB_NAME_TEST=booking_test

# TASK-X4 group photos: S3-compatible storage (MinIO in docker-compose; real S3 works too)
S3_ENDPOINT=http://localhost:9000
# Address browsers use for photo links (same as S3_ENDPOINT unless the API runs inside Docker)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=booking
S3_SECRET_KEY=booking-secret
S3_BUCKET=group-photos
S3_BUCKET_TEST=group-photos-test
# Presigned photo links expire after this many seconds
S3_LINK_TTL_SECONDS=3600
# MinIO web console: http://localhost:9001 (log in with S3_ACCESS_KEY / S3_SECRET_KEY)
